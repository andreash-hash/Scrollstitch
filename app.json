{
  "expo": {
    "name": "ScrollStitch",
    "slug": "scrollstitch",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scrollstitch",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f3f2f2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.scrollstitch",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "ScrollStitch needs access to your screen recordings so it can extract the frames and stitch them into one long screenshot.",
        "NSPhotoLibraryAddUsageDescription": "ScrollStitch saves your finished long screenshot to your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.scrollstitch",
      "adaptiveIcon": {
        "backgroundColor": "#f3f2f2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#ec3013"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ScrollStitch needs access to your photo library to open the screen recording you want to stitch.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://replit.com/"
      },
      "eas": {
        "projectId": "8a12376a-e19b-4c1e-88bf-33de8d7d4776"
      }
    },
    "owner": "hvitostn"
  }
}
